{
    "manufacturer": "PandaKB.COM",
    "maintainer": "RustyC0der",
    "bootloader": "rp2040",
    "diode_direction": "COL2ROW",
    "features": {
        "bootmagic": true,
        "encoder": true,
        "extrakey": true,
        "mousekey": true,
        "nkro": false,
        "oled": true,
        "rgb_matrix": true
    },
    "processor": "RP2040",
    "qmk": {
        "tap_keycode_delay": 10
    },
    "split": {
        "enabled": true,
        "handedness": {
            "pin": "GP4"
        },
        "serial": {
            "driver": "vendor",
            "pin": "GP1"
        },
        "transport": {
            "protocol": "serial",
            "sync": {
                "indicators": true,
                "layer_state": true,
                "modifiers": true,
                "oled": true,
                "wpm": true
            }
        }
    },
    "url": "https://github.com/RuStyC0der/QMK-firmware-for-keyboards",
    "usb": {
        "device_version": "1.0.0",
        "vid": "0xFC32"
    },
    "ws2812": {
        "driver": "vendor",
        "pin": "GP0"
    }
}
